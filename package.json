{
  "name": "unichamada-desktop",
  "version": "1.0.0",
  "description": "Aplicativo oficial para gerenciamento de chamadas e painel administrativo em ambiente acadêmico.",
  "main": "main.js",
  "author": "Adalberto Gomes",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "start:ti": "electron . --ti",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac --universal --publish never",
    "build:win": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.unichamada.desktop",
    "productName": "UniChamada",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!build/**",
      "!.github/**",
      "!*.sql",
      "!releases/**",
      "!skills/**",
      "!banco-de-dados/**",
      "!docker-compose.yml",
      "!README.md",
      "!software/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "pkg"
      ],
      "category": "public.app-category.education",
      "identity": null,
      "artifactName": "UniChamada-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "Instalar UniChamada"
    },
    "pkg": {
      "installLocation": "/Applications"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UniChamada",
      "language": "1046",
      "include": "build/installer.nsh",
      "artifactName": "UniChamada-Setup-${version}.exe"
    }
  }
}
