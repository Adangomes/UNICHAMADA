docker exec -it iris-ponto bash -c 'cat << "EOF" > /usr/irissys/csp/user/totem.csp
<script language="cache" runat="server">
  // Permite acesso público/sessão no CSP do IRIS
</script>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>UniChamada – Totem de Ponto</title>
    <link rel="icon" href="data:,">
    <!-- Estilos -->
    <link rel="stylesheet" href="./css/totem.css">
</head>
<body>
    <!-- Só scripts. As telas e os estilos são montados por JavaScript. -->
    <div id="app"></div>

    <!-- Lógica e Injeção da Interface -->
    <script src="./js/totem.js"></script>
</body>
</html>
EOF'
