{
  "name": "unichamada-desktop",
  "version": "1.0.0",
  "description": "Aplicativo oficial para gerenciamento de chamadas e painel administrativo em ambiente acadêmico.",
  "main": "main.js",
  "author": "Seu Nome / Equipe Acadêmica",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "electron": "33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.unichamada.desktop",
    "productName": "UniChamada",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "zip"
    }
  }
}